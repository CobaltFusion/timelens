{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noImplicitAny": false,
    },
    "include": [
        "src/**/*.js"
    ],
    "exclude": [
        "node_modules",
        "venv"
    ]
}
